@inject IStringLocalizer<SharedResource> Loc

<div class="custom-id-editor">
    <h4>@Loc["Custom ID"]</h4>

    @for (var i = 0; i < editorFormat.Parts.Count; i++)
    {
        var part = editorFormat.Parts[i];
        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">@Loc["Type"]</label>
                        <InputSelect class="form-select" @bind-Value="part.Type">
                            @foreach (var type in Enum.GetValues<CustomIdPartType>())
                            {
                                <option value="@type">@type</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">@Loc["Fixed text"]</label>
                        <input class="form-control" value="@part.FixedText" @oninput="e => part.FixedText = e.Value?.ToString() ?? string.Empty" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">@Loc["Length"]</label>
                        <input type="number" class="form-control" value="@part.Length" @oninput="e => part.Length = int.TryParse(e.Value?.ToString(), out var value) ? value : null" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">@Loc["Format"]</label>
                        <input class="form-control" value="@part.Format" @oninput="e => part.Format = e.Value?.ToString() ?? string.Empty" />
                    </div>

                    <div class="col-md-1 text-end">
                        <button type="button" class="btn btn-outline-secondary me-1" @onclick="() => MovePart(i, -1)">↑</button>
                        <button type="button" class="btn btn-outline-secondary me-1" @onclick="() => MovePart(i, 1)">↓</button>
                        <button type="button" class="btn btn-outline-danger" @onclick="() => RemovePart(i)">✖</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="d-flex gap-2 align-items-center mb-3">
        <InputSelect class="form-select w-auto" @bind-Value="newPartType">
            @foreach (var type in Enum.GetValues<CustomIdPartType>())
            {
                <option value="@type">@type</option>
            }
        </InputSelect>
        <button type="button" class="btn btn-outline-primary" @onclick="AddPart">@Loc["Add part"]</button>
    </div>

    <button type="button" class="btn btn-primary" @onclick="Save">@Loc["Save"]</button>
</div>

@code {
    [Parameter] public CustomIdFormat Format { get; set; } = new();
    [Parameter] public EventCallback<CustomIdFormat> FormatChanged { get; set; }
    [Parameter] public EventCallback SaveFormat { get; set; }
    [Parameter] public Guid InventoryId { get; set; }

    private CustomIdFormat editorFormat = new();
    private CustomIdPartType newPartType = CustomIdPartType.FixedText;

    protected override void OnParametersSet()
    {
        editorFormat = CloneFormat(Format);
    }

    private void AddPart()
    {
        editorFormat.Parts.Add(new CustomIdPart
        {
            Type = newPartType,
            FixedText = string.Empty,
            Length = null,
            Format = string.Empty
        });
    }

    private void RemovePart(int index)
    {
        if (index >= 0 && index < editorFormat.Parts.Count)
        {
            editorFormat.Parts.RemoveAt(index);
        }
    }

    private void MovePart(int index, int offset)
    {
        var newIndex = index + offset;
        if (newIndex < 0 || newIndex >= editorFormat.Parts.Count)
        {
            return;
        }

        var item = editorFormat.Parts[index];
        editorFormat.Parts.RemoveAt(index);
        editorFormat.Parts.Insert(newIndex, item);
    }

    private async Task Save()
    {
        await FormatChanged.InvokeAsync(CloneFormat(editorFormat));
        if (SaveFormat.HasDelegate)
        {
            await SaveFormat.InvokeAsync();
        }
    }

    private static CustomIdFormat CloneFormat(CustomIdFormat source)
    {
        return new CustomIdFormat
        {
            Parts = source.Parts.Select(p => new CustomIdPart
            {
                Type = p.Type,
                FixedText = p.FixedText,
                Length = p.Length,
                Format = p.Format
            }).ToList()
        };
    }
}