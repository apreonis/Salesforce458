@using Microsoft.AspNetCore.Components.Authorization
@inject IStringLocalizer<SharedResource> Loc

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid nav-header">
        <a class="navbar-brand" href="/">Inventory Management</a>

        <button type="button" class="navbar-toggler" @onclick="ToggleNavMenu" aria-label="Navigation menu">
            <span class="navbar-toggler-line"></span>
            <span class="navbar-toggler-line"></span>
            <span class="navbar-toggler-line"></span>
        </button>
    </div>
</div>

<div class="nav-shell">
    <div class="@NavMenuCssClass nav-popup">
        <nav class="flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link home-link" href="/" Match="NavLinkMatch.All">
                    @Loc["Home"]
                </NavLink>
            </div>

            <AuthorizeView>
                <Authorized>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="/create-inventory">
                            @Loc["Create Inventory"]
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="/profile">
                            @Loc["My Profile"]
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="/admin/users">
                            @Loc["Admin"]
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>
        </nav>
    </div>
</div>

@code {
    private bool collapseNavMenu = true;

    private string NavMenuCssClass => collapseNavMenu ? "collapse" : "show";

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}